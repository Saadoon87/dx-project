<?xml version="1.0" encoding="UTF-8"?>
<CustomTab xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
        This connects the Salesforce tab to the Lightning Web Component.
        For CustomTab metadata, use the LWC bundle name only.
        Do not use c:ulsCalculator here.
    -->
    <lwcComponent>ulsCalculator</lwcComponent>

    <!--
        Label shown to users in Salesforce navigation.
    -->
    <label>ULS Calculator</label>

    <!--
        Icon/motif for the tab.
    -->
    <motif>Custom57: Building Block</motif>
</CustomTab>